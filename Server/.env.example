# ===========================
# Server Config
# ===========================
PORT=5000
SERVER_URL=http://localhost:5000

NODE_ENV=development

# ===========================
# JWT Authentication
# ===========================
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=30min

REFRESH_SECRET=your_refresh_secret_key
REFRESH_TOKEN_EXPIRES_IN=7d

# ===========================
# MSSQL Database (Development)
# ===========================
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_SERVER=your_database_server_ip_or_domain
DB_DATABASE=your_database_name
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# ===========================
# AWS S3 Storage
# ===========================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your_bucket_name

# ===========================
# CORS
# ===========================
ALLOWED_ORIGINS=http://localhost:5173

# ===========================
# Cron Job Settings
# ===========================
IS_CRON_ON=false
CRON_API_KEY=your_cron_service_api_key
INTERVAL=300000
CREATED_BY_USER_ID=your_user_id
LEAD_SOURCE_NAME=India Mart

# ===========================
# Facebook Lead Integration
# ===========================
FB_VERIFY_TOKEN=your_facebook_verify_token
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret
FB_ACCESS_TOKEN_ENV=your_facebook_page_access_token
FB_GRAPH_API_VERSION=v19.0
FACEBOOK_LEAD_SOURCE_NAME=Facebook
